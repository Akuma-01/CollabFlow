NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
# Set to your actual trusted proxy hop count when deploying behind a proxy.
TRUST_PROXY_HOPS=0

# Generate two different secrets; production requires at least 32 characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=

DB_USER=postgres
DB_HOST=127.0.0.1
DB_DATABASE=collabflow
DB_PASSWORD=
DB_PORT=5432

# Alternatively, a URL takes precedence over DB_HOST/USER/DATABASE/PASSWORD/PORT.
# Use a direct or session-pooled connection: LISTEN cannot use transaction pooling.
# DATABASE_URL=postgresql://user:password@host:5432/collabflow
# URL connections default to verified TLS; discrete local settings default to plaintext.
# DB_SSL_MODE=verify-full
# Optional provider CA certificate file, with real PEM contents:
# DB_SSL_CA_FILE=/absolute/path/to/provider-ca.pem
